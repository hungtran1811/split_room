# Copy to .env.local for local development.
# On Netlify: set these in Site settings → Environment variables.

VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=

# --- Cloud Functions secrets (NOT Vite / NOT committed) ---
# Set via Firebase Functions env / secrets manager when deploying functions.
# Example (do not put real values in source control):
#   firebase functions:secrets:set RESEND_API_KEY
#   firebase functions:secrets:set CLOSE_FROM_EMAIL
#
# RESEND_API_KEY=re_xxx          # Resend API key used by processMailOutbox
# CLOSE_FROM_EMAIL=SplitRoom <noreply@your-verified-domain.com>
